# 可选：与 config.yaml 中的占位符一一对应。
# 设置了这些环境变量时，Web 配置中的同名密钥字段将由环境变量优先提供。
TUSHARE_TOKEN=
WECHAT_WEBHOOK_URL=
SIGNAL_WEBHOOK_URL=
SIGNAL_WEBHOOK_AUTH=
SIGNAL_EMAIL_SENDER=
SIGNAL_EMAIL_PASSWORD=
SIGNAL_EMAIL_RECEIVER=

# Web 数据目录（默认 quant-python/web/data）
# WEB_DATA_DIR=D:\quant\web-data

# AI 解读（interpretReport）单次模型请求超时（秒）。生成大报告解读时
# 模型响应常超过 60s，默认 180；模型更慢可调大。
# MODEL_TIMEOUT_SECONDS=180

# 模型 API 出口代理（可选）。解析顺序：MODEL_PROXY → HTTPS_PROXY → HTTP_PROXY → 模型设置的代理字段。
# 模型字段留空时按环境区分出口：本地开发机设 MODEL_PROXY=http://127.0.0.1:7890，线上不设即直连。
# 用 MODEL_PROXY 而非 HTTPS_PROXY 可避免 Python 数据桥子进程也走代理。
# MODEL_PROXY=http://127.0.0.1:7890

# 本地开发机设此变量跳过调度器(定时任务)，线上不设即正常运行。
# 共享数据库时只要线上一个实例跑调度器，本地不参与。
# SCHEDULER_DISABLED=1

# PostgreSQL 连接（server-only；URL-encode 密码）
# 方式一（推荐）：同机自建库 quant-db（Docker 内部网络，切换时叠加 docker-compose.db.yml）
#   DATABASE_URL=postgresql://quant_app:<password>@quant-db:5432/quant
#   DATABASE_SSL_MODE=disable
#   DB_MODE=selfhost                    # 部署模式（selfhost 叠加 db override；legacy 仅主 compose）
#   PG_OWNER_PASSWORD=<owner 密码>      # schema 所有者（DDL/setup）
#   PG_APP_PASSWORD=<应用密码>          # 应用运行角色（DATABASE_URL 使用；仅字母/数字/下划线）
#   PG_BACKUP_PASSWORD=<备份密码>       # 备份只读角色（pg_dump；仅字母/数字/下划线）
# 方式二：外部 PostgreSQL / Supabase session pooler
#   DATABASE_URL=postgresql://postgres.<project-ref>:<password>@aws-0-ap-southeast-1.pooler.supabase.com:5432/postgres
#   DATABASE_SSL_REJECT_UNAUTHORIZED=true
# DATABASE_POOL_MAX=5
