{
  "name": "web",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "db:tunnel": "node scripts/db-tunnel.mjs",
    "build": "next build",
    "start": "next start -H 127.0.0.1 -p 3111",
    "lint": "eslint",
    "test": "vitest run",
    "db:setup": "node --env-file-if-exists=.env.local scripts/setup-postgres.mjs",
    "db:migrate": "node --env-file-if-exists=.env.local scripts/migrate-database.mjs sqlite-to-postgres",
    "db:rollback-snapshot": "node --env-file-if-exists=.env.local scripts/migrate-database.mjs postgres-to-sqlite",
    "db:verify": "node --env-file-if-exists=.env.local scripts/verify-postgres.mjs"
  },
  "dependencies": {
    "@base-ui/react": "^1.7.0",
    "better-sqlite3": "^13.0.3",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "lucide-react": "^1.31.0",
    "next": "16.3.1",
    "next-themes": "^0.4.6",
    "node-cron": "^4.6.0",
    "pg": "^8.23.0",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "react-markdown": "^10.1.0",
    "remark-gfm": "^4.0.1",
    "shadcn": "^4.18.0",
    "sonner": "^2.0.8",
    "tailwind-merge": "^3.6.0",
    "tw-animate-css": "^1.4.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/better-sqlite3": "^9.6.0",
    "@types/node": "^20",
    "@types/node-cron": "^3.0.11",
    "@types/pg": "^8.23.1",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.3.1",
    "jsdom": "^30.0.1",
    "tailwindcss": "^4",
    "typescript": "^5",
    "vitest": "^4.1.10"
  }
}
